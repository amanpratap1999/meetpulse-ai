# Server Configuration
PORT=8000
HOST=127.0.0.1
DEBUG=True

# Database Configuration (Default is local SQLite; set to postgresql://user:pass@host/db for PostgreSQL)
DATABASE_URL=sqlite:///./meetings.db

# LLM Configuration
# Set MOCK_LLM=true to test locally without an API key. Set to false when LLM_API_KEY is provided.
MOCK_LLM=true

# Supported providers: groq, openai
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile

# Embeddings Configuration
# Options: local (built-in cosine vector hash), groq, openai
EMBEDDING_PROVIDER=local
